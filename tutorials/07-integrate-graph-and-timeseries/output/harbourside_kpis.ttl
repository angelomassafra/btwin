<https://example.org/harbourside/B1-electricity-db> a btwin:Document ;
    rdfs:label "Library - electricity readings 2025" ;
    ifc:HasPropertySets <https://example.org/harbourside/B1-electricity-db-PSET> .

<https://example.org/harbourside/B1-electricity-db-PSET> a ifc:IfcPropertySet ;
    rdfs:label "Database Location" ;
    ifc:HasProperties [ a ifc:IfcPropertySingleValue ;
            rdfs:label "PeriodEnd" ;
            ifc:NominalValue "2025-12-01T00:00:00Z" ],
        [ a ifc:IfcPropertySingleValue ;
            rdfs:label "RowCount" ;
            ifc:NominalValue 12 ;
            ifc:Unit "rows" ],
        [ a ifc:IfcPropertySingleValue ;
            rdfs:label "FilePath" ;
            ifc:NominalValue "output/databases/HB-B1-electricity.db" ],
        [ a ifc:IfcPropertySingleValue ;
            rdfs:label "SensorID" ;
            ifc:NominalValue "HB-B1-EM" ],
        [ a ifc:IfcPropertySingleValue ;
            rdfs:label "Unit" ;
            ifc:NominalValue "kWh" ],
        [ a ifc:IfcPropertySingleValue ;
            rdfs:label "TableName" ;
            ifc:NominalValue "observations" ],
        [ a ifc:IfcPropertySingleValue ;
            rdfs:label "ObservedProperty" ;
            ifc:NominalValue "ElectricityConsumption" ],
        [ a ifc:IfcPropertySingleValue ;
            rdfs:label "PeriodStart" ;
            ifc:NominalValue "2025-01-01T00:00:00Z" ] .

