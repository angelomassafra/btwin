<https://example.org/harbourside/Library-Energy-Performance-2025> a btwin:KPISet ;
    rdfs:label "Energy Performance 2025" ;
    eko:hasAssociatedObject <https://example.org/harbourside/B1> ;
    eko:hasEvaluationTimestep [ a time1:interval ;
            time1:hasBeginning "2025-01-01T00:00:00Z" ;
            time1:hasEnd "2025-12-01T00:00:00Z" ] ;
    btwin:hasKPIs <https://example.org/harbourside/Library-Energy-Performance-2025-AnnualElectricityUse>,
        <https://example.org/harbourside/Library-Energy-Performance-2025-ElectricityUseIntensity> .

